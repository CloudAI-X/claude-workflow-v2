{
  "$comment": "MCP server configurations. Copy to .mcp.json in your project root and delete the servers you don't need. Team-shared file checked into git. Remote (http) servers sign in through /mcp inside Claude Code, so no tokens are stored here.",
  "mcpServers": {
    "github": {
      "$comment": "GitHub integration - PRs, issues, code search",
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "slack": {
      "$comment": "Slack integration - search channels, post messages, read threads",
      "type": "http",
      "url": "https://mcp.slack.com/mcp"
    },
    "sentry": {
      "$comment": "Sentry error tracking - fetch errors, stack traces",
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "linear": {
      "$comment": "Linear issue tracking - create/update issues, view sprints",
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "notion": {
      "$comment": "Notion workspace - search pages, read/write content",
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "filesystem": {
      "$comment": "Extended filesystem access beyond working directory",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/directory"]
    },
    "memory": {
      "$comment": "Persistent memory across sessions",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "postgres": {
      "$comment": "PostgreSQL database queries (read DATABASE_URL from your environment)",
      "command": "npx",
      "args": ["-y", "@bytebase/dbhub", "--dsn", "${DATABASE_URL}"]
    }
  }
}
